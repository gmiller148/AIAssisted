{
  "outputStyle": "default",
  "permissions": {
    "allow": [
      "Bash(node .claude/tools/render.mjs:*)",
      "Bash(python3 .claude/hooks/md_log.py:*)",
      "Write(.claude/tools/work/**)",
      "Edit(.claude/tools/work/**)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/md_log.py\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/md_log.py\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/md_log.py\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
